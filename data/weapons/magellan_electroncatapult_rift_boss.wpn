{
	"id":"magellan_electroncatapult_rift_boss",  # this id must match what's in the spreadsheet
	"specClass":"projectile",
	"type":"BALLISTIC",
	"size":"SMALL",
	"turretSprite":"graphics/Magellan/weapons/magellan_electronthrower_turret.png",
	"turretGlowSprite":"graphics/Magellan/weapons/magellan_electronthrower_turret_glow.png",	
	"hardpointSprite":"graphics/Magellan/weapons/magellan_silverdart_hardpoint_base.png",
	"hardpointGlowSprite":"graphics/Magellan/weapons/magellan_silverdart_hardpoint_glow.png",
	"glowColor":[155,215,245,200],
	"turretOffsets":[11, 0],
	"turretAngleOffsets":[0],
	"hardpointOffsets":[11, 0],
	"hardpointAngleOffsets":[0],	
	"barrelMode":"LINKED", # DUAL, LINKED or ALTERNATING.  whether barrels fire at the same time, linked, or alternate.
	"animationType":"GLOW_AND_FLASH",  # NONE, GLOW, MUZZLE_FLASH, SMOKE
	"autocharge":true,  # whether the weapon will continue charging and fire if the LMB is tapped instead of held
	"muzzleFlashSpec":{"length":21.0,   # only used if animationType = MUZZLE_FLASH
					   "spread":7.0,
					   "particleSizeMin":8.0,
					   "particleSizeRange":12.0,
					   "particleDuration":0.15,
					   "particleCount":16,
					   "particleColor":[120,180,210,175]},
	"projectileSpecId":"magellan_electroncatapult_rift_boss_shot",  # projectile that will be fired
	"fireSoundTwo":"magellan_ebolter_fire",	

	"everyFrameEffect":"data.scripts.plugins.MagellanTrailPlugin"
}