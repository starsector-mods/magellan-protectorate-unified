{
	"id":"magellan_smartafm",
	"specClass":"missile",	
	"onHitEffect":"data.scripts.weapons.magellan_StrikeMissileOnHit",
	"missileType":"MISSILE",
	"sprite":"graphics/Magellan/missiles/magellan_eheatseeker.png",
	"size":[6,12],	
	"center":[3,6],
	"collisionRadius":12,
	"collisionClass":"MISSILE_NO_FF",
	"explosionColor":[100,110,255,255],  # purely visual, will get a white additively blended core on top of this color
	"explosionRadius":20, # purely visual
	"explosionSpec":{"duration":0.1, # not visual
					 "radius":40,
					 "coreRadius":20, # full damage within core radius
					 "collisionClass":HITS_SHIPS_AND_ASTEROIDS,
					 "collisionClassByFighter":HITS_SHIPS_AND_ASTEROIDS,
					 "particleSizeMin":5.0,
					 "particleSizeRange":3.0,
					 "particleDuration":1.6,
					 "particleCount":12,
					 "particleColor":[100,110,255,255]},	
	"fadeTime":1, # fadeout duration
	"engineSpec":{"turnAcc":1800,
				  "turnRate":420,
				  "acc":2000,
				  "dec":1000},
	"engineSlots":[{"id":"ES1",
					"loc":[-5, 0],
				    "style":"CUSTOM",
					"styleSpec":{
						"mode":"QUAD_STRIP", # PARTICLES or QUAD_STRIP, determines which params are used
						"engineColor":[100,165,255,255],
						"glowSizeMult":0.5,
						"contrailDuration":1.5,
						"contrailWidthMult":0.6,
						"contrailWidthAddedFractionAtEnd":3,  # can be negative. makes trail spread out/narrow at the end
						"contrailMinSeg":3, # min segment length, in pixels
						"contrailMaxSpeedMult":0.0,
						"contrailAngularVelocityMult":0.5,
						"contrailSpawnDistMult":0.5, # how far away from engine it starts
						"contrailColor":[100,165,255,155],
						"type":"SMOKE" # GLOW or SMOKE; additive or regular blend mode
					},
				    "width":5.0,
				    "length":30.0,
				    "angle":180.0}
		],    
}

