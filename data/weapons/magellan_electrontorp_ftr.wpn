{
	"id":"magellan_electrontorp_ftr",  # this id must match what's in the spreadsheet
	"specClass":"projectile",
	#"everyFrameEffect": "data.scripts.weapons.magellan_ElectroTorpFX",
	"type":"ENERGY",
	"size":"SMALL",
	"turretSprite":"graphics/Magellan/weapons/magellan_electrontorp_turret_base.png",
	"turretGunSprite":"graphics/Magellan/weapons/magellan_electrontorp_turret_recoil.png",
	"turretGlowSprite":"graphics/Magellan/weapons/magellan_electrontorp_turret_glow.png",
	"hardpointSprite":"graphics/Magellan/weapons/magellan_electrontorp_hardpoint_base.png",
	"hardpointGunSprite":"graphics/Magellan/weapons/magellan_electrontorp_hardpoint_recoil.png",
	"hardpointGlowSprite":"graphics/Magellan/weapons/magellan_electrontorp_hardpoint_glow.png",
	"visualRecoil":3.0,  # the gun sprites are only used if this is non-0
	"glowColor":[100,110,255,255],
	"turretOffsets":[0, 0],
	"turretAngleOffsets":[0],
	"hardpointOffsets":[0, 0],
	"hardpointAngleOffsets":[0],
	"renderHints":[RENDER_BARREL_BELOW],
	"barrelMode":"ALTERNATING", # or LINKED.  whether barrels fire at the same time or alternate.
	"animationType":"GLOW_AND_FLASH",
	"muzzleFlashSpec":{"length":12.0,   # only used if animationType = MUZZLE_FLASH
					   "spread":6.0,
					   "particleSizeMin":10.0,
					   "particleSizeRange":12.0,
					   "particleDuration":0.15,
					   "particleCount":12,
					   "particleColor":[100,110,255,255]},
	"autocharge":true,  # whether the weapon will continue charging and fire if the LMB is tapped instead of held
	"projectileSpecId":"magellan_electrontorp_ftr_shot",  # projectile that will be fired
	"fireSoundTwo":"magellan_electrontorpedo_fire"
}